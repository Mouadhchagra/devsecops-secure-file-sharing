# Copy this file to .env and replace every value with your own.
# NEVER commit the real .env file.

# ===== PostgreSQL (database) =====
POSTGRES_USER=secureshare
POSTGRES_PASSWORD=change-me
POSTGRES_DB=secureshare
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ===== MinIO (file storage, S3-compatible) =====
MINIO_ROOT_USER=change-me
MINIO_ROOT_PASSWORD=change-me-at-least-8-chars
MINIO_ENDPOINT=localhost:9000
MINIO_BUCKET=secureshare-files

# ===== App secrets (used from Day 2 and Day 3) =====
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=change-me
# 32 random bytes, base64. Generate with: python -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
MASTER_KEY=change-me
